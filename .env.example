APP_NAME=FastAPI Hugging Face RAG
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=7
HF_TOKEN=hf_xxx
HF_PROVIDER=auto
HF_EMBEDDING_MODEL=thenlper/gte-large
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct-1M
HF_TIMEOUT_SECONDS=60
HF_EMBEDDING_BATCH_SIZE=16
HF_MAX_RETRIES=3
EMBEDDING_DIMENSION=1024
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.65
RETRIEVAL_MODE=hybrid
HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_CANDIDATE_MULTIPLIER=4
HYBRID_RRF_K=60
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_OUTPUT_TOKENS=700
RAG_TEMPERATURE=0.1
REGISTER_RATE_LIMIT_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_15_MIN=10
RAG_RATE_LIMIT_PER_MIN=30
UPLOAD_RATE_LIMIT_PER_HOUR=20
MAX_UPLOAD_MB=20
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=documents
CORS_ORIGINS=["http://localhost:3000"]
