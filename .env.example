APP_NAME=FastAPI Hugging Face RAG
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=7
HF_TOKEN=hf_xxx
HF_PROVIDER=auto
HF_EMBEDDING_MODEL=thenlper/gte-large
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct-1M
HF_TIMEOUT_SECONDS=60
EMBEDDING_DIMENSION=1024
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.65
MAX_UPLOAD_MB=20
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
CORS_ORIGINS=["http://localhost:3000"]

